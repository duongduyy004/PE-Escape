  nodes:
  - id: opening
    lines:
    - characterId: anh_khoa_tren
      pose: 0
      text: "Bu\u1ED5i \u0111\u1EA7u nh\u1EDB nghe k\u1EF9 y\xEAu c\u1EA7u. M\xF4n
        n\xE0y kh\xF4ng ph\u1EA3i c\u1EE9 c\xF3 m\u1EB7t l\xE0 qua \u0111\xE2u."
      sticker:
    - characterId: mai_toang
      pose: 0
      text: "T\u1EDB c\u1EE9 t\u01B0\u1EDFng \u0111\u1EA7u k\u1EF3 ch\u1EC9 \u0111i\u1EC3m
        danh. C\u1EADu c\xF3 t\u1EADp ch\u1EA1y tr\u01B0\u1EDBc kh\xF4ng?"
      sticker:
    - characterId: tan_thu
      pose: 0
      text: "Ch\u01B0a... T\u1EDB ch\u1EC9 mong kh\xF4ng ph\u1EA3i h\u1ECDc l\u1EA1i
        ngay n\u0103m \u0111\u1EA7u."
      sticker:
    - characterId: co_the_chat
      pose: 0
      text: "Ch\u1EA1y, b\xF3ng chuy\u1EC1n, b\xF3ng \u0111\xE1, r\u1ED3i b\xE0i
        ki\u1EC3m tra cu\u1ED1i. \u0110\u1EA1t ph\u1EA7n tr\u01B0\u1EDBc m\u1EDBi
        h\u1ECDc ph\u1EA7n sau. Kh\xF4ng h\u1ECDc \u0111\u01B0\u1EE3c th\xEC n\u1EE3."
      sticker:
  - id: sprint_intro
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "45 gi\xE2y: b\u1EA5m tr\xE1i, ph\u1EA3i lu\xE2n phi\xEAn. \u0110\u1EA1t
        chu\u1ED7i 12 nh\u1ECBp h\u1EE3p l\u1EC7 \xEDt nh\u1EA5t m\u1ED9t l\u1EA7n.
        Sai th\xEC l\xE0m l\u1EA1i chu\u1ED7i trong th\u1EDDi gian c\xF2n l\u1EA1i."
      sticker:
    - characterId: mai_toang
      pose: 0
      text: "B\u1EA5m nh\u1EA7m th\xEC th\u1EED l\u1EA1i chu\u1ED7i. C\u1EE9 gi\u1EEF
        nh\u1ECBp \u0111\u1EBFn khi h\u1EBFt gi\u1EDD."
      sticker:
    - characterId: tan_thu
      pose: 0
      text: "\u1EEA. \u0110\u1EC3 t\u1EDB th\u1EED t\u1EEBng nh\u1ECBp \u0111\xE3."
      sticker:
  - id: sprint_exam
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "150 m\xE9t, t\u1ED1i \u0111a 15 gi\xE2y. T\xF4i b\u1EA5m gi\u1EDD, kh\xF4ng
        nghe gi\u1EA3i th\xEDch."
      sticker: "15 GI\xC2Y"
    - characterId: tan_thu
      pose: 0
      text: "D\u1EA1. Mong l\xE0 em gi\u1EEF \u0111\u01B0\u1EE3c nh\u1ECBp nh\u01B0
        l\xFAc t\u1EADp."
      sticker:
  - id: sprint_pass
    lines:
    - characterId: co_the_chat
      pose: 1
      text: "T\u1EA1m \u0111\u01B0\u1EE3c. \u0110\u1EA1t ph\u1EA7n ch\u1EA1y. \u0110\u1EEBng
        t\u01B0\u1EDFng th\u1EBF l\xE0 xong h\u1ECDc ph\u1EA7n."
      sticker: "\u0110\u1EA0T"
    - characterId: mai_toang
      pose: 0
      text: "Qua ph\u1EA7n ch\u1EA1y r\u1ED3i. Th\u1EDF l\u1EA1i \u0111\xE3, c\xF2n
        b\xF3ng chuy\u1EC1n n\u1EEFa."
      sticker:
  - id: volleyball_intro
    lines:
    - characterId: mai_toang
      pose: 0
      text: "Nh\xECn ch\u1ED7 b\xF3ng r\u01A1i tr\u01B0\u1EDBc. \u0110\u1EE9ng l\u1EC7ch
        l\xE0 \u0111\u1EE1 h\u1EE5t ngay."
      sticker:
    - characterId: co_the_chat
      pose: 0
      text: "\u0110\u1EE1 b\xF3ng 3 l\u1EA7n, ph\xE1t b\xF3ng 2 l\u1EA7n, r\u1ED3i
        nh\u1EA3y \u0111\xE1nh tr\u1EA3 2 l\u1EA7n. M\u1ED7i b\xEAn ch\u1EA1m t\u1ED1i
        \u0111a ba l\u1EA7n."
      sticker:
    - characterId: tan_thu
      pose: 0
      text: "D\u1EA1. C\xF4 cho em v\xE0o v\u1ECB tr\xED \u0111\xE3 \u1EA1."
      sticker:
  - id: volleyball_exam
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "Ghi \u0111\u1EE7 10 \u0111i\u1EC3m tr\u01B0\u1EDBc \u0111\u1ED1i th\u1EE7.
        Kh\xF4ng gi\u1EDBi h\u1EA1n th\u1EDDi gian, c\u1EE9 ch\u1EAFc t\u1EEBng \u0111i\u1EC3m."
      sticker: "10 \u0110I\u1EC2M"
    - characterId: mai_toang
      pose: 0
      text: "\u0110\u1EEBng nh\xECn b\u1EA3ng \u0111i\u1EC3m su\u1ED1t. C\u1EE9 theo
        b\xF3ng, xong l\u01B0\u1EE3t r\u1ED3i t\xEDnh."
      sticker:
    - characterId: tan_thu
      pose: 0
      text: "\u1EEA. T\u1EDB ch\u1EC9 s\u1EE3 cu\u1ED1ng r\u1ED3i b\u1EA5m s\u1EDBm."
      sticker:
  - id: volleyball_pass
    lines:
    - characterId: co_the_chat
      pose: 1
      text: "\u0110\u1EA1t. \xCDt ra c\u1EADu \u0111\xE3 bi\u1EBFt \u0111\xF3n b\xF3ng,
        kh\xF4ng \u0111\u1EE9ng nh\xECn n\u1EEFa."
      sticker: "\u0110\u1EA0T"
    - characterId: tan_thu
      pose: 1
      text: "D\u1EA1... Qua \u0111\u01B0\u1EE3c hai ph\u1EA7n r\u1ED3i."
      sticker:
  - id: soccer_intro
    lines:
    - characterId: mai_toang
      pose: 0
      text: "\u0110\u1EBFn b\xF3ng \u0111\xE1 r\u1ED3i. T\u1EDB th\u1EA5y l\xFAc
        l\u1EA5y l\u1EF1c d\u1EC5 th\u1EA3 tay mu\u1ED9n l\u1EAFm."
      sticker:
    - characterId: anh_khoa_tren
      pose: 0
      text: "Anh c\u0169ng t\u1EEBng s\xFAt v\u1ECDt x\xE0 v\xEC gi\u1EEF n\xFAt
        l\xE2u qu\xE1. \u0110\u1EEBng ch\u1EC9 ch\u0103m ch\u0103m s\xFAt m\u1EA1nh."
      sticker:
    - characterId: co_the_chat
      pose: 0
      text: "T\u1EADp g\xF3c s\xFAt v\xE0 l\u1EF1c s\xFAt tr\u01B0\u1EDBc. B\xE0i
        thi c\xF3 \u0111\xFAng n\u0103m l\u01B0\u1EE3t. S\xFAt ra ngo\xE0i c\u0169ng
        t\xEDnh m\u1ED9t l\u01B0\u1EE3t."
      sticker:
  - id: soccer_exam
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "N\u0103m l\u01B0\u1EE3t s\xFAt, \xEDt nh\u1EA5t ba b\xE0n. Th\u1EE7
        m\xF4n kh\xF4ng c\xF3 nhi\u1EC7m v\u1EE5 gi\xFAp c\u1EADu qua m\xF4n."
      sticker: "5 L\u01AF\u1EE2T"
    - characterId: tan_thu
      pose: 0
      text: "D\u1EA1. Em s\u1EBD nh\xECn l\u1EA1i g\xF3c tr\u01B0\u1EDBc khi s\xFAt."
      sticker:
  - id: soccer_pass
    lines:
    - characterId: co_the_chat
      pose: 1
      text: "\u0110\u1EA1t ph\u1EA7n b\xF3ng \u0111\xE1. C\xF2n b\xE0i ki\u1EC3m
        tra cu\u1ED1i v\u1EDBi t\xF4i. Ch\u01B0a \u0111\u1EBFn l\xFAc c\u1EA5t \u0111\u1ED3."
      sticker: "\u0110\u1EA0T"
    - characterId: mai_toang
      pose: 0
      text: "C\xF2n m\u1ED9t b\xE0i n\u1EEFa. Ng\u1ED3i xu\u1ED1ng cho \u0111\u1EE1
        run ch\xE2n \u0111\xE3."
      sticker:
  - id: chess_intro
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "B\xE0i cu\u1ED1i l\xE0 m\u1ED9t th\u1EBF c\u1EDD. Chi\u1EBFu h\u1EBFt
        trong s\u1ED1 n\u01B0\u1EDBc cho ph\xE9p. L\u1EA7n n\xE0y d\xF9ng \u0111\u1EA7u,
        kh\xF4ng d\xF9ng ch\xE2n."
      sticker: "B\xC0I CU\u1ED0I"
    - characterId: tan_thu
      pose: 0
      text: "D\u1EA1, c\u1EDD vua \u1EA1? Em ch\u01B0a ch\u01A1i nhi\u1EC1u..."
      sticker:
    - characterId: co_the_chat
      pose: 0
      text: "M\u1ED7i th\u1EBF c\u1EDD c\xF3 gi\u1EDBi h\u1EA1n s\u1ED1 n\u01B0\u1EDBc
        v\xE0 th\u1EDDi gian ri\xEAng. \u0110\u1ECDc \u0111\u1EC1 cho k\u1EF9 r\u1ED3i
        h\xE3y \u0111i."
      sticker: "TH\u1EBE C\u1EDC M\u1EDAI"
  - id: supplementary
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "Ph\u1EA7n \u0111\xE3 \u0111\u1EA1t t\xF4i gi\u1EEF nguy\xEAn. Ph\u1EA7n
        ch\u01B0a \u0111\u1EA1t th\xEC \xF4n l\u1EA1i. L\u1EA7n sau t\xF4i v\u1EABn
        ch\u1EA5m theo y\xEAu c\u1EA7u c\u0169."
      sticker:
    - characterId: mai_toang
      pose: 0
      text: "C\u1EADu hay v\u01B0\u1EDBng ch\u1ED7 n\xE0o th\xEC t\u1EADp l\u1EA1i
        ch\u1ED7 \u0111\xF3. L\xE0m y nh\u01B0 l\u1EA7n tr\u01B0\u1EDBc l\u1EA1i
        tr\u01B0\u1EE3t th\xF4i."
      sticker:
  - id: course_complete
    lines:
    - characterId: co_the_chat
      pose: 1
      text: "\u0110\u1EA1t h\u1ECDc ph\u1EA7n. C\u1EADu kh\xF4ng ph\u1EA3i h\u1ECDc
        l\u1EA1i v\u1EDBi kh\xF3a sau. Nh\u1EDB gi\u1EEF k\u1EBFt qu\u1EA3 n\xE0y."
      sticker: "HO\xC0N TH\xC0NH"
    - characterId: tan_thu
      pose: 1
      text: "D\u1EA1, em c\u1EA3m \u01A1n c\xF4. Cu\u1ED1i c\xF9ng c\u0169ng qua
        r\u1ED3i."
      sticker:
    - characterId: anh_khoa_tren
      pose: 0
      text: "Qua r\u1ED3i th\xEC v\u1EC1 ngh\u1EC9. L\u1EA7n sau c\xF3 m\xF4n th\u1EC3
        ch\u1EA5t, nh\u1EDB t\u1EADp s\u1EDBm h\u01A1n."
      sticker:
    - characterId: mai_toang
      pose: 0
      text: "\u0110i th\xF4i. T\u1EDB \u0111\xF3i t\u1EEB l\xFAc thi ch\u1EA1y \u0111\u1EBFn
        gi\u1EDD."
      sticker:
