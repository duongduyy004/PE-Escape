  nodes:
  - id: opening
    lines:
    - characterId: anh_khoa_tren
      pose: 0
      text: "\xD4i em \u01A1i, m\xF4n n\xE0y l\xE0 n\u1ED7i \xE1c m\u1ED9ng c\u1EE7a
        sinh vi\xEAn tr\u01B0\u1EDDng r\u1ED3i. Ch\xFAc em may m\u1EAFn. C\u1ED1
        l\xEAn, r\u1ED3i s\u1EBD \u0111\u01B0\u1EE3c B\u1EADt c\xF3c th\xF4i."
      sticker:
    - characterId: mai_toang
      pose: 0
      text: "T\u1EDB nghe c\xE1c anh ch\u1ECB d\u1ECDa m\xE3i m\xE0 v\u1EABn kh\xF4ng
        tin. Nh\xECn c\xF4 l\xE0 th\u1EA5y c\xF3 chuy\u1EC7n r\u1ED3i."
      sticker:
    - characterId: tan_thu
      pose: 0
      text: "T\u1EDB c\xF2n ch\u01B0a bi\u1EBFt ph\u1EA3i ch\u1EA1y th\u1EBF n\xE0o.
        Ch\u1EC9 mong \u0111\u1EEBng b\u1ECB n\u1EE3 m\xF4n ngay k\u1EF3 \u0111\u1EA7u."
      sticker:
    - characterId: co_the_chat
      pose: 0
      text: "C\xE1c c\xF4 c\xE1c c\u1EADu \u0111\xE3 b\u01B0\u1EDBc v\xE0o \u0111\xE2y
        h\u1ECDc th\u1EC3 ch\u1EA5t th\xEC ph\u1EA3i nghe theo hi\u1EC7u l\u1EC7nh
        c\u1EE7a t\xF4i. L\u1EDB ng\u1EDB t\xF4i cho n\u1EE3 m\xF4n b\u1EA5t c\u1EE9
        l\xFAc n\xE0o."
      sticker:
  - id: sprint_intro
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "Kh\u1EDFi \u0111\u1ED9ng cho k\u1EF9. Khi nghe c\xF2i hi\u1EC7u l\u1EC7nh,
        t\u1EA5t c\u1EA3 ch\u1EA1y."
      sticker:
    - characterId: mai_toang
      pose: 0
      text: "C\xF4 b\u1EAFt ch\u1EA1y m\u1EC7t th\u1EADt. T\u1EDB m\u1EDBi \u0111\u1EE9ng
        \u1EDF v\u1EA1ch m\xE0 \u0111\xE3 th\u1EA5y ch\xE2n run r\u1ED3i."
      sticker:
    - characterId: tan_thu
      pose: 0
      text: "H\u1EBFt h\u1ED3n. T\u1EDB c\xF2n ch\u01B0a ch\u1EA1y m\xE0 \u0111\xE3
        s\u1EE3 kh\xF4ng theo k\u1ECBp c\u1EA3 l\u1EDBp."
      sticker:
  - id: sprint_exam
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "\u0110\u1ED1i v\u1EDBi b\xE0i thi n\xE0y, c\u1EADu ph\u1EA3i bi\u1EBFt
        gi\u1EEF nh\u1ECBp ch\u1EA1y \u0111\u1EC1u hai ch\xE2n. Kh\xF4ng l\xE0m \u0111\u01B0\u1EE3c
        n\u1EEFa th\xEC h\u1ECDc l\u1EA1i v\u1EDBi kh\xF3a sau \u0111i. 150 m\xE9t,
        t\u1ED1i \u0111a 40 gi\xE2y."
      sticker: "40 GI\xC2Y"
    - characterId: tan_thu
      pose: 0
      text: "D\u1EA1... em s\u1EBD c\u1ED1 gi\u1EEF nh\u1ECBp. C\xF4 \u0111\u1EEBng
        th\u1ED5i c\xF2i s\u1EDBm qu\xE1 \u1EA1."
      sticker:
  - id: sprint_pass
    lines:
    - characterId: co_the_chat
      pose: 1
      text: "\u0110\u1EA1t. \u0110\u1EEBng t\u01B0\u1EDFng qua \u0111\u01B0\u1EE3c
        m\u1ED9t m\xF4n \u0111\xE3 l\xE0 t\xE0i. S\u1EBD c\xF2n g\u1EB7p t\xF4i d\xE0i
        d\xE0i."
      sticker: "\u0110\u1EA0T"
    - characterId: mai_toang
      pose: 0
      text: "H\u1EBFt h\u1ED3n. T\xED n\u1EEFa t\u1EDB t\u01B0\u1EDFng kh\xF4ng qua.
        C\xF4 b\u1EAFt ch\u1EA1y m\u1EC7t qu\xE1."
      sticker:
  - id: volleyball_intro
    lines:
    - characterId: mai_toang
      pose: 0
      text: "B\xF3ng chuy\u1EC1n c\xF2n m\u1EC7t h\u01A1n ch\u1EA1y \u0111\u1EA5y.
        \u0110\u1EE1 kh\xF4ng k\u1ECBp l\xE0 b\xF3ng r\u01A1i ngay tr\u01B0\u1EDBc
        m\u1EB7t."
      sticker:
    - characterId: co_the_chat
      pose: 0
      text: "B\xF3ng sang th\xEC di chuy\u1EC3n \u0111\u1EBFn \u0111\xFAng v\u1ECB
        tr\xED, \u0111\u1EE1 b\xF3ng v\xE0 \u0111\xE1nh b\xF3ng l\u1EA1i cho \u0111\u1ED1i
        ph\u01B0\u01A1ng. Ch\u1EC9 bi\u1EBFt nh\xECn b\xF3ng th\xEC d\u0129 nhi\xEAn
        l\xE0 n\u1EE3."
      sticker:
    - characterId: tan_thu
      pose: 0
      text: "Em ch\u01B0a quen \u0111\u1EE1 b\xF3ng ki\u1EC3u n\xE0y..."
      sticker:
  - id: volleyball_exam
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "B\xEAn n\xE0o \u0111\u1EE7 10 \u0111i\u1EC3m tr\u01B0\u1EDBc th\xEC
        qua m\xF4n. Kh\xF4ng \u0111\u1EA1t th\xEC l\u1EA1i ra m\xE0 b\u1EADt c\xF3c."
      sticker: "10 \u0110I\u1EC2M"
    - characterId: mai_toang
      pose: 0
      text: "C\u1EE9 nh\xECn b\xF3ng m\xE0 \u0111\u1EE1. \u0110\u1EEBng cu\u1ED1ng
        l\xEAn v\xEC m\u1ED9t \u0111i\u1EC3m, t\u1EDB c\u0169ng \u0111ang run \u0111\xE2y."
      sticker:
    - characterId: tan_thu
      pose: 0
      text: "T\u1EDB s\u1EE3 b\xF3ng bay th\u1EB3ng v\xE0o ng\u01B0\u1EDDi r\u1ED3i
        kh\xF4ng k\u1ECBp \u0111\u1EE1 \u1EA5y ch\u1EE9. \u0110\xFAng l\xE0 \xE1c
        m\u1ED9ng."
      sticker:
  - id: volleyball_pass
    lines:
    - characterId: co_the_chat
      pose: 1
      text: "C\u1EADu n\xE0y qua."
      sticker: "\u0110\u1EA0T"
    - characterId: tan_thu
      pose: 1
      text: "H\u1EBFt h\u1ED3n. Hai m\xF4n r\u1ED3i m\xE0 t\u1EDB v\u1EABn ch\u01B0a
        quen v\u1EDBi c\xE1ch c\xF4 nh\xECn c\u1EA3 s\xE2n."
      sticker:
  - id: soccer_intro
    lines:
    - characterId: mai_toang
      pose: 0
      text: "\u0110\u1EBFn b\xF3ng \u0111\xE1 r\u1ED3i. T\u1EDB ch\u1EC9 s\u1EE3
        s\xFAt m\xE3i kh\xF4ng v\xE0o, nh\xECn th\u1EE7 m\xF4n l\xE0 m\u1EA5t b\xECnh
        t\u0129nh."
      sticker:
    - characterId: anh_khoa_tren
      pose: 0
      text: "N\u0103m ngo\xE1i anh ch\u1EE7 quan. C\u1EE9 t\u01B0\u1EDFng s\xFAt
        m\u1EA1nh l\xE0 \u0111\u01B0\u1EE3c, cu\u1ED1i c\xF9ng b\xF3ng bay qua khung
        th\xE0nh."
      sticker:
    - characterId: co_the_chat
      pose: 0
      text: "C\u1EADu c\xF3 \u0111\xFAng n\u0103m l\u01B0\u1EE3t. S\xFAt ra ngo\xE0i
        c\u0169ng t\xEDnh m\u1ED9t l\u01B0\u1EE3t, \u0111\u1EEBng mong t\xF4i cho
        th\xEAm."
      sticker:
  - id: soccer_exam
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "N\u0103m l\u01B0\u1EE3t s\xFAt, ghi \u0111\u01B0\u1EE3c \xEDt nh\u1EA5t
        ba b\xE0n th\xEC qua."
      sticker: "5 L\u01AF\u1EE2T"
    - characterId: tan_thu
      pose: 0
      text: "D\u1EA1... em s\u1EBD c\u1ED1 kh\xF4ng s\xFAt th\u1EB3ng v\xE0o th\u1EE7
        m\xF4n."
      sticker:
  - id: soccer_pass
    lines:
    - characterId: co_the_chat
      pose: 1
      text: "\u0110\u1EA1t. \u0110\u1EEBng t\u01B0\u1EDFng ba m\xF4n qua l\xE0 xong.
        C\u1EADu v\u1EABn c\xF2n m\u1ED9t b\xE0i ki\u1EC3m tra cu\u1ED1i c\xF9ng."
      sticker: "\u0110\u1EA0T"
    - characterId: mai_toang
      pose: 0
      text: "C\xF2n m\u1ED9t b\xE0i n\u1EEFa th\xF4i. C\u1ED1 l\xEAn n\xE0o!"
      sticker:
  - id: chess_intro
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "B\xE0i n\xE0y cho m\u1ED9t th\u1EBF c\u1EDD, c\u1EADu m\xE0 kh\xF4ng
        chi\u1EBFu h\u1EBFt \u0111\u01B0\u1EE3c trong s\u1ED1 n\u01B0\u1EDBc quy
        \u0111\u1ECBnh th\xEC t\u1EF1 gi\xE1c m\xE0 b\u1EADt c\xF3c."
      sticker: "B\xC0I CU\u1ED0I"
    - characterId: tan_thu
      pose: 0
      text: "D\u1EA1, c\u1EDD vua \u1EA1? Em t\u01B0\u1EDFng qua b\xF3ng \u0111\xE1
        l\xE0 \u0111\u01B0\u1EE3c v\u1EC1 r\u1ED3i."
      sticker:
    - characterId: co_the_chat
      pose: 0
      text: "T\xF4i cho c\u1EADu \u0111\xFAng 90 gi\xE2y suy ngh\u0129. T\xEAn c\u1EADu
        l\xE0 g\xEC \u0111\u1EC3 t\xF4i ghi v\xE0o s\u1ED5 lu\xF4n?"
      sticker: "90 GI\xC2Y"
  - id: supplementary
    lines:
    - characterId: co_the_chat
      pose: 0
      text: "Ph\u1EA7n \u0111\xE3 \u0111\u1EA1t t\xF4i gi\u1EEF nguy\xEAn. Ph\u1EA7n
        ch\u01B0a \u0111\u1EA1t th\xEC h\u1ECDc l\u1EA1i. H\u1ECDc l\u1EA1i t\xF4i
        v\u1EABn ch\u1EA5m \u0111\xFAng y\xEAu c\u1EA7u c\u0169, \u0111\u1EEBng c\xF3
        mong d\u1EC5 h\u01A1n."
      sticker:
    - characterId: mai_toang
      pose: 0
      text: "C\u1EADu v\u01B0\u1EDBng ch\u1ED7 n\xE0o th\xEC t\u1EADp l\u1EA1i ch\u1ED7
        \u0111\xF3. N\u0103m ngo\xE1i anh Tu\u1EA5n c\u0169ng b\u1ECB ph\u1EA1t v\u1EADy,
        kh\xF4ng ai tho\xE1t \u0111\u01B0\u1EE3c \u0111\xE2u."
      sticker:
  - id: course_complete
    lines:
    - characterId: co_the_chat
      pose: 1
      text: "T\u1ED1t, c\u1EADu n\xE0y \u0111\u01B0\u1EE3c. \u0110\u1EA1t h\u1ECDc
        ph\u1EA7n. \u0110\u1EEBng t\u01B0\u1EDFng qua \u0111\u01B0\u1EE3c h\u1EBFt
        h\xF4m nay th\xEC n\u0103m sau kh\u1ECFi g\u1EB7p t\xF4i."
      sticker: "HO\xC0N TH\xC0NH"
    - characterId: tan_thu
      pose: 1
      text: "H\u1EBFt h\u1ED3n... em t\u01B0\u1EDFng m\xECnh ph\u1EA3i h\u1ECDc l\u1EA1i
        th\u1EADt."
      sticker:
    - characterId: anh_khoa_tren
      pose: 0
      text: "Ch\xFAc m\u1EEBng em. Anh n\xF3i r\u1ED3i, m\xF4n n\xE0y kh\xF4ng tho\xE1t
        \u0111\u01B0\u1EE3c \u0111\xE2u. N\u0103m ngo\xE1i anh c\u0169ng b\u1ECB
        ph\u1EA1t B\u1EADt c\xF3c."
      sticker:
    - characterId: mai_toang
      pose: 0
      text: "\u0110i th\xF4i. T\u1EDB \u0111\xF3i t\u1EEB l\xFAc c\xF4 b\u1EAFt ch\u1EA1y
        \u0111\u1EBFn gi\u1EDD. \u0110\xFAng l\xE0 \xE1c m\u1ED9ng."
      sticker:
