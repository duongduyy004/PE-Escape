%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d031820a90773502bb0465c2341e28bb, type: 3}
  m_Name: GameplayDialogues
  m_EditorClassIdentifier: KMA.Gameplay.UI::KMA.Gameplay.UI.GameplayDialogueLibrary
  events:
  - Id: chess.start
    ReactionGroup: chess.start
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 1
      Text: "T\u1ED1i \u0111a {maxMoves} n\u01B0\u1EDBc, {timeSeconds} gi\xE2y. Kh\xF4ng
        chi\u1EBFu h\u1EBFt \u0111\u01B0\u1EE3c th\xEC ch\u1ECBu kh\xF3 ng\u1ED3i
        l\xE0m l\u1EA1i."
      Poses:
      - {fileID: 21300000, guid: efdeccb35e60ab644a3fc342c819896c, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: chess.mistake1
    ReactionGroup: chess.mistake1
    Priority: 2
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 1
      Text: "\u0110i th\u1EBF n\xE0y th\xEC c\u1EADu \u0111\u1ECBnh chi\u1EBFu h\u1EBFt
        ki\u1EC3u g\xEC? C\xF2n {movesRemaining} n\u01B0\u1EDBc, ngh\u0129 cho k\u1EF9."
      Poses:
      - {fileID: 21300000, guid: cb8d85216148d7f4b92d77cfa78b6d43, type: 3}
      - {fileID: 21300000, guid: 90e44a2ae5e46ac4590c173e3c2f8c7a, type: 3}
      - {fileID: 21300000, guid: f72682024a6fba6438d96db10d911d3e, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: chess.mistake2
    ReactionGroup: chess.mistake2
    Priority: 2
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 1
      Text: "L\u1EA1i \u0111i nh\u01B0 th\u1EBF. C\u1EADu \u0111\u1ECBnh ng\u1ED3i
        \u0111\xE2y \u0111\u1EBFn l\xFAc kh\xF3a sau v\xE0o h\u1ECDc \xE0?"
      Poses:
      - {fileID: 21300000, guid: cb8d85216148d7f4b92d77cfa78b6d43, type: 3}
      - {fileID: 21300000, guid: 90e44a2ae5e46ac4590c173e3c2f8c7a, type: 3}
      - {fileID: 21300000, guid: a107eb87b301f3d44bdbf3ece7c14b5e, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: chess.solved
    ReactionGroup: chess.solved
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 1
      Text: "T\u1EA1m \u0111\u01B0\u1EE3c. B\xE0i n\xE0y qua."
      Poses:
      - {fileID: 21300000, guid: a4cabbc0a6c81094e9ed4516f93efda8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: chess.timeout
    ReactionGroup: chess.timeout
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 1
      Text: "H\u1EBFt gi\u1EDD. Ng\u1ED3i nh\xECn b\xE0n c\u1EDD kh\xF4ng l\xE0m
        xu\u1EA5t hi\u1EC7n n\u01B0\u1EDBc chi\u1EBFu h\u1EBFt \u0111\xE2u."
      Poses:
      - {fileID: 21300000, guid: efdeccb35e60ab644a3fc342c819896c, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: chess.failed
    ReactionGroup: chess.failed
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 1
      Text: "Ch\u01B0a \u0111\u1EA1t. Ng\u1ED3i xu\u1ED1ng l\xE0m l\u1EA1i, \u0111\u1EEBng
        t\u01B0\u1EDFng c\u1EE9 \u0111i h\u1EBFt n\u01B0\u1EDBc l\xE0 \u0111\u01B0\u1EE3c
        v\u1EC1."
      Poses:
      - {fileID: 21300000, guid: a107eb87b301f3d44bdbf3ece7c14b5e, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: chess.hint1
    ReactionGroup: chess.hint1
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 0
    Lines:
    - Speaker: 1
      Text: "C\xF2n \u0111\u01B0\u1EDDng chi\u1EBFu h\u1EBFt trong {mateDistance}
        n\u01B0\u1EDBc. Nh\xECn c\xE1c n\u01B0\u1EDBc chi\u1EBFu, \u0111\u1EEBng
        ch\u1EC9 ng\u1ED3i nh\xECn qu\xE2n."
      Poses:
      - {fileID: 21300000, guid: dab09163e19971749928f30bad23f7b1, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 8
      Icon: {fileID: 0}
  - Id: chess.hint2
    ReactionGroup: chess.hint2
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 0
    Lines:
    - Speaker: 1
      Text: "Nh\xECn qu\xE2n {piece} \u1EDF {from}. C\u1EADu b\u1ECF qua qu\xE2n
        \u0111\xF3 r\u1ED3i."
      Poses:
      - {fileID: 21300000, guid: 6f387be5ded38a944bbadf12f49241d8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 8
      Icon: {fileID: 0}
  - Id: chess.hint3
    ReactionGroup: chess.hint3
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 0
    Lines:
    - Speaker: 1
      Text: "\u0110i {piece} t\u1EEB {from} \u0111\u1EBFn {to}{promotionSuffix}.
        T\xF4i ch\u1EC9 \u0111\u1EBFn th\u1EBF n\xE0y r\u1ED3i, \u0111\u1EEBng b\u1EA3o
        l\xE0 ch\u01B0a bi\u1EBFt \u0111i \u0111\xE2u."
      Poses:
      - {fileID: 21300000, guid: 6f387be5ded38a944bbadf12f49241d8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 8
      Icon: {fileID: 0}
  - Id: sp.learn.start
    ReactionGroup: sp.learn.start
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "M\u1EDBi kh\u1EDFi \u0111\u1ED9ng m\xE0 ch\xE2n t\u1EDB \u0111\xE3 run
        r\u1ED3i."
      Poses:
      - {fileID: 21300000, guid: eb306838f1648ff4493c1114140c26f0, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "V\xE0o v\u1ECB tr\xED. Nghe c\xF2i th\xEC ch\u1EA1y, \u0111\u1EEBng
        \u0111\u1EC3 t\xF4i ph\u1EA3i g\u1ECDi t\u1EEBng c\u1EADu."
      Poses:
      - {fileID: 21300000, guid: 6f387be5ded38a944bbadf12f49241d8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: sp.learn.wrong
    ReactionGroup: sp.learn.wrong
    Priority: 2
    CooldownSeconds: 10
    MaximumPlays: 2
    Lines:
    - Speaker: 0
      Text: "T\u1EDB l\u1EA1i h\u1EE5t nh\u1ECBp r\u1ED3i..."
      Poses:
      - {fileID: 21300000, guid: 0f238b424326d5f4eaceb42e22ffcc94, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Hai ch\xE2n ch\u1EA1y cho \u0111\u1EC1u. \u0110\u1ECBnh c\u1EE9 lo\u1EA1ng
        cho\u1EA1ng th\u1EBF \u0111\u1EBFn h\u1EBFt bu\u1ED5i \xE0?"
      Poses:
      - {fileID: 21300000, guid: dab09163e19971749928f30bad23f7b1, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: sp.learn.done
    ReactionGroup: sp.learn.done
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "H\u1EBFt h\u1ED3n. T\xED n\u1EEFa t\u1EDB t\u01B0\u1EDFng kh\xF4ng qua."
      Poses:
      - {fileID: 21300000, guid: 91fb22986ca6ab44db67a945e981b821, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "T\u1EA1m \u0111\u01B0\u1EE3c. V\xE0o b\xE0i luy\u1EC7n."
      Poses:
      - {fileID: 21300000, guid: a4cabbc0a6c81094e9ed4516f93efda8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
  - Id: sp.practice.start
    ReactionGroup: sp.practice.start
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "C\xF4 b\u1EAFt ch\u1EA1y n\u1EEFa \xE0? T\u1EDB v\u1EABn ch\u01B0a h\u1EBFt
        m\u1EC7t."
      Poses:
      - {fileID: 21300000, guid: 54c331363a4367842a76a9fc67d0c5ee, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Ch\u01B0a \u0111\u1EBFn \u0111\xEDch th\xEC ch\u01B0a \u0111\u01B0\u1EE3c
        ngh\u1EC9. Gi\u1EEF nh\u1ECBp hai ch\xE2n, ch\u1EA1y cho h\u1EBFt b\xE0i."
      Poses:
      - {fileID: 21300000, guid: efdeccb35e60ab644a3fc342c819896c, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: sp.practice.break
    ReactionGroup: sp.practice.break
    Priority: 2
    CooldownSeconds: 10
    MaximumPlays: 2
    Lines:
    - Speaker: 0
      Text: "T\u1EDB l\u1EA1i h\u1EE5t nh\u1ECBp r\u1ED3i."
      Poses:
      - {fileID: 21300000, guid: 0f238b424326d5f4eaceb42e22ffcc94, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Kh\xF4ng gi\u1EEF \u0111\u01B0\u1EE3c nh\u1ECBp th\xEC \u0111\u1EBFn
        b\xE0i thi c\u1EADu \u0111\u1ECBnh l\xE0m g\xEC?"
      Poses:
      - {fileID: 21300000, guid: 6f387be5ded38a944bbadf12f49241d8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: sp.practice.done
    ReactionGroup: sp.practice.done
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "May qu\xE1, em k\u1ECBp r\u1ED3i."
      Poses:
      - {fileID: 21300000, guid: 91fb22986ca6ab44db67a945e981b821, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "T\u1EA1m \u0111\u01B0\u1EE3c. V\xE0o thi v\u1EABn ch\u1EA1y th\u1EBF
        n\xE0y th\xEC ch\u01B0a ch\u1EAFc qua \u0111\xE2u."
      Poses:
      - {fileID: 21300000, guid: a4cabbc0a6c81094e9ed4516f93efda8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: sp.exam.start
    ReactionGroup: sp.exam.start
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "D\u1EA1... c\xF4 cho em \u0111\u1EE9ng v\u1EEFng \u0111\xE3 \u1EA1."
      Poses:
      - {fileID: 21300000, guid: 54c331363a4367842a76a9fc67d0c5ee, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "V\xE0o v\u1ECB tr\xED. Khi nghe c\xF2i hi\u1EC7u l\u1EC7nh, t\u1EA5t
        c\u1EA3 ch\u1EA1y."
      Poses:
      - {fileID: 21300000, guid: cb8d85216148d7f4b92d77cfa78b6d43, type: 3}
      - {fileID: 21300000, guid: 90e44a2ae5e46ac4590c173e3c2f8c7a, type: 3}
      - {fileID: 21300000, guid: f72682024a6fba6438d96db10d911d3e, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: sp.exam.lowtime
    ReactionGroup: sp.exam.lowtime
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "V\u1EABn ch\u01B0a t\u1EDBi... s\u1EAFp h\u1EBFt gi\u1EDD r\u1ED3i."
      Poses:
      - {fileID: 21300000, guid: 54c331363a4367842a76a9fc67d0c5ee, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "V\u1EA1ch \u0111\xEDch ngay tr\u01B0\u1EDBc m\u1EB7t. Kh\xF4ng ch\u1EA1y
        \u0111\u01B0\u1EE3c n\u1EEFa th\xEC h\u1ECDc l\u1EA1i v\u1EDBi kh\xF3a sau."
      Poses:
      - {fileID: 21300000, guid: efdeccb35e60ab644a3fc342c819896c, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: sp.exam.stumble
    ReactionGroup: sp.exam.stumble
    Priority: 2
    CooldownSeconds: 10
    MaximumPlays: 2
    Lines:
    - Speaker: 0
      Text: Ui da!
      Poses:
      - {fileID: 21300000, guid: 6a1d60edaf60eaf478c6a59c2e02e02b, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Gi\u1EEF th\u0103ng b\u1EB1ng, ch\u1EA1y ti\u1EBFp. T\xF4i ch\u01B0a
        b\u1EA3o d\u1EEBng."
      Poses:
      - {fileID: 21300000, guid: 6f387be5ded38a944bbadf12f49241d8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
  - Id: vb.learn.start
    ReactionGroup: vb.learn.start
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "T\u1EDB s\u1EE3 b\xF3ng \u0111\u1EADp v\xE0o m\u1EB7t qu\xE1."
      Poses:
      - {fileID: 21300000, guid: 54c331363a4367842a76a9fc67d0c5ee, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "\u0110\u1EE9ng v\xE0o v\u1ECB tr\xED. B\xF3ng sang th\xEC \u0111\u1EE1,
        kh\xF4ng ai \u0111\u1EE1 h\u1ED9 c\u1EADu \u0111\xE2u."
      Poses:
      - {fileID: 21300000, guid: 6f387be5ded38a944bbadf12f49241d8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: vb.learn.miss
    ReactionGroup: vb.learn.miss
    Priority: 2
    CooldownSeconds: 10
    MaximumPlays: 2
    Lines:
    - Speaker: 0
      Text: "H\u1EBFt h\u1ED3n, t\u1EDB ch\u01B0a k\u1ECBp t\u1EDBi..."
      Poses:
      - {fileID: 21300000, guid: 0f238b424326d5f4eaceb42e22ffcc94, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "B\xF3ng r\u01A1i ngay tr\u01B0\u1EDBc m\u1EB7t m\xE0 c\u1EADu v\u1EABn
        \u0111\u1EE9ng nh\xECn. Di chuy\u1EC3n s\u1EDBm l\xEAn."
      Poses:
      - {fileID: 21300000, guid: dab09163e19971749928f30bad23f7b1, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: vb.learn.done
    ReactionGroup: vb.learn.done
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "T\u1EDB \u0111\u1EE1 \u0111\u01B0\u1EE3c r\u1ED3i... may qu\xE1."
      Poses:
      - {fileID: 21300000, guid: 91fb22986ca6ab44db67a945e981b821, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "T\u1EA1m \u0111\u01B0\u1EE3c. \u0110\u1EBFn b\xE0i luy\u1EC7n."
      Poses:
      - {fileID: 21300000, guid: a4cabbc0a6c81094e9ed4516f93efda8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
  - Id: vb.practice.start
    ReactionGroup: vb.practice.start
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "Tay t\u1EDB v\u1EABn c\xF2n run. Kh\xF4ng bi\u1EBFt \u0111\u1EE1 n\u1ED5i
        kh\xF4ng."
      Poses:
      - {fileID: 21300000, guid: eb306838f1648ff4493c1114140c26f0, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "\u0110\u1EE1 cho ch\u1EAFc r\u1ED3i \u0111\xE1nh qua l\u01B0\u1EDBi.
        \u0110\u1EE9ng nh\xECn b\xF3ng th\xEC ch\u1EC9 c\xF3 n\u1EE3 m\xF4n."
      Poses:
      - {fileID: 21300000, guid: efdeccb35e60ab644a3fc342c819896c, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: vb.practice.badtime
    ReactionGroup: vb.practice.badtime
    Priority: 2
    CooldownSeconds: 10
    MaximumPlays: 2
    Lines:
    - Speaker: 0
      Text: "T\u1EDB \u0111\u1EE1 l\u1EC7ch r\u1ED3i."
      Poses:
      - {fileID: 21300000, guid: 0f238b424326d5f4eaceb42e22ffcc94, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Ch\u1EDD b\xF3ng v\xE0o t\u1EA7m r\u1ED3i h\xE3y \u0111\xE1nh."
      Poses:
      - {fileID: 21300000, guid: 6f387be5ded38a944bbadf12f49241d8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: vb.practice.done
    ReactionGroup: vb.practice.done
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "\u0110\u1EE7 n\u0103m \u0111i\u1EC3m r\u1ED3i. T\u1EDB t\u01B0\u1EDFng
        c\xF4 b\u1EAFt l\xE0m l\u1EA1i."
      Poses:
      - {fileID: 21300000, guid: 91fb22986ca6ab44db67a945e981b821, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "T\u1EA1m \u0111\u01B0\u1EE3c. \u0110\u1EEBng v\xE0o thi r\u1ED3i l\u1EA1i
        \u0111\u1EE9ng nh\xECn b\xF3ng."
      Poses:
      - {fileID: 21300000, guid: a4cabbc0a6c81094e9ed4516f93efda8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: vb.exam.start
    ReactionGroup: vb.exam.start
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "T\u1EDB v\u1EABn run tay. Mong l\xE0 \u0111\u1EE1 \u0111\u01B0\u1EE3c
        qu\u1EA3 \u0111\u1EA7u."
      Poses:
      - {fileID: 21300000, guid: 54c331363a4367842a76a9fc67d0c5ee, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "V\xE0o v\u1ECB tr\xED. \u0110\u1EE1 cho ch\u1EAFc, \u0111\xE1nh qua
        l\u01B0\u1EDBi. \u0110\u1EE7 10 \u0111i\u1EC3m m\u1EDBi \u0111\u1EA1t."
      Poses:
      - {fileID: 21300000, guid: f72682024a6fba6438d96db10d911d3e, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: vb.exam.lostpoint
    ReactionGroup: vb.exam.lostpoint
    Priority: 2
    CooldownSeconds: 10
    MaximumPlays: 2
    Lines:
    - Speaker: 0
      Text: "L\u1EA1i m\u1EA5t m\u1ED9t \u0111i\u1EC3m... t\u1EDB cu\u1ED1ng qu\xE1."
      Poses:
      - {fileID: 21300000, guid: 0f238b424326d5f4eaceb42e22ffcc94, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "M\u1EA5t \u0111i\u1EC3m r\u1ED3i th\xEC chu\u1EA9n b\u1ECB qu\u1EA3
        sau. \u0110\u1EE9ng ti\u1EBFc c\u0169ng kh\xF4ng \u0111\u01B0\u1EE3c c\u1ED9ng
        l\u1EA1i \u0111\xE2u."
      Poses:
      - {fileID: 21300000, guid: dab09163e19971749928f30bad23f7b1, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: vb.exam.dive
    ReactionGroup: vb.exam.dive
    Priority: 2
    CooldownSeconds: 10
    MaximumPlays: 2
    Lines:
    - Speaker: 0
      Text: Ui da!
      Poses:
      - {fileID: 21300000, guid: 6a1d60edaf60eaf478c6a59c2e02e02b, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "\u0110\u1EE9ng d\u1EADy v\xE0 theo ti\u1EBFp \u0111\u01B0\u1EDDng b\xF3ng.
        T\xF4i ch\u01B0a cho ngh\u1EC9."
      Poses:
      - {fileID: 21300000, guid: 6f387be5ded38a944bbadf12f49241d8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: vb.exam.matchpoint
    ReactionGroup: vb.exam.matchpoint
    Priority: 0
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "C\xF2n m\u1ED9t \u0111i\u1EC3m n\u1EEFa th\xF4i..."
      Poses:
      - {fileID: 21300000, guid: 54c331363a4367842a76a9fc67d0c5ee, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Ch\u01B0a \u0111\u1EE7 10 \u0111i\u1EC3m th\xEC ch\u01B0a \u0111\u01B0\u1EE3c
        ngh\u1EC9."
      Poses:
      - {fileID: 21300000, guid: f72682024a6fba6438d96db10d911d3e, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: fb.learn.start
    ReactionGroup: fb.learn.start
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "Kh\xF4ng c\xF3 th\u1EE7 m\xF4n m\xE0 t\u1EDB v\u1EABn th\u1EA5y run."
      Poses:
      - {fileID: 21300000, guid: 54c331363a4367842a76a9fc67d0c5ee, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Khung th\xE0nh tr\u1ED1ng r\u1ED3i \u0111\u1EA5y. Ch\u1EA1y \u0111\xE0,
        nh\xECn h\u01B0\u1EDBng r\u1ED3i s\xFAt, \u0111\u1EEBng \u0111\xE1 ra ngo\xE0i
        n\u1EEFa."
      Poses:
      - {fileID: 21300000, guid: 6f387be5ded38a944bbadf12f49241d8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: fb.learn.miss
    ReactionGroup: fb.learn.miss
    Priority: 2
    CooldownSeconds: 10
    MaximumPlays: 2
    Lines:
    - Speaker: 0
      Text: "Tr\u1ED1ng th\u1EBF m\xE0 v\u1EABn tr\u01B0\u1EE3t, \u0111\xFAng l\xE0
        \xE1c m\u1ED9ng."
      Poses:
      - {fileID: 21300000, guid: 0f238b424326d5f4eaceb42e22ffcc94, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Nh\xECn khung th\xE0nh r\u1ED3i s\xFAt. \u0110\u1EEBng \u0111\xE1 l\xEAn
        tr\u1EDDi."
      Poses:
      - {fileID: 21300000, guid: dab09163e19971749928f30bad23f7b1, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: fb.learn.done
    ReactionGroup: fb.learn.done
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "\u0110\u1EE7 r\u1ED3i... may qu\xE1."
      Poses:
      - {fileID: 21300000, guid: 91fb22986ca6ab44db67a945e981b821, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "T\u1EA1m \u0111\u01B0\u1EE3c. B\xE0i sau c\xF3 th\u1EE7 m\xF4n, \u0111\u1EEBng
        t\u01B0\u1EDFng v\u1EABn d\u1EC5 th\u1EBF n\xE0y."
      Poses:
      - {fileID: 21300000, guid: a4cabbc0a6c81094e9ed4516f93efda8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: fb.practice.start
    ReactionGroup: fb.practice.start
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "C\xF3 th\u1EE7 m\xF4n r\u1ED3i... t\u1EDB ph\u1EA3i ng\u1EAFm cho k\u1EF9."
      Poses:
      - {fileID: 21300000, guid: 54c331363a4367842a76a9fc67d0c5ee, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "S\xE1u l\u01B0\u1EE3t, \xEDt nh\u1EA5t hai b\xE0n. M\u1ED7i c\xFA s\xFAt
        \u0111\u1EC1u t\xEDnh."
      Poses:
      - {fileID: 21300000, guid: f72682024a6fba6438d96db10d911d3e, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: fb.practice.saved
    ReactionGroup: fb.practice.saved
    Priority: 2
    CooldownSeconds: 10
    MaximumPlays: 2
    Lines:
    - Speaker: 0
      Text: "B\u1ECB b\u1EAFt m\u1EA5t r\u1ED3i."
      Poses:
      - {fileID: 21300000, guid: 0f238b424326d5f4eaceb42e22ffcc94, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "S\xFAt th\u1EB3ng v\xE0o th\u1EE7 m\xF4n th\xEC c\u1EADu mong b\xF3ng
        \u0111i \u0111\xE2u?"
      Poses:
      - {fileID: 21300000, guid: dab09163e19971749928f30bad23f7b1, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: fb.practice.done
    ReactionGroup: fb.practice.done
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "Em \u0111\u01B0\u1EE3c hai b\xE0n r\u1ED3i... c\xF3 qua kh\xF4ng \u1EA1?"
      Poses:
      - {fileID: 21300000, guid: 91fb22986ca6ab44db67a945e981b821, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "\u0110\u1EA1t. V\xE0o thi c\u1EA7n ba b\xE0n, \u0111\u1EEBng v\u1ED9i
        m\u1EEBng."
      Poses:
      - {fileID: 21300000, guid: a4cabbc0a6c81094e9ed4516f93efda8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: fb.exam.start
    ReactionGroup: fb.exam.start
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "N\u0103m l\u01B0\u1EE3t th\xF4i... t\u1EDB s\u1EE3 l\u1EA1i s\xFAt ra
        ngo\xE0i."
      Poses:
      - {fileID: 21300000, guid: eb306838f1648ff4493c1114140c26f0, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Ch\u1EA1y \u0111\xE0, ng\u1EAFm g\xF3c r\u1ED3i s\xFAt. Ra ngo\xE0i
        c\u0169ng t\xEDnh m\u1ED9t l\u01B0\u1EE3t, \u0111\u1EEBng xin th\xEAm."
      Poses:
      - {fileID: 21300000, guid: f72682024a6fba6438d96db10d911d3e, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: fb.exam.goal
    ReactionGroup: fb.exam.goal
    Priority: 0
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "V\xE0o r\u1ED3i... c\xF2n ph\u1EA3i ghi th\xEAm."
      Poses:
      - {fileID: 21300000, guid: 91fb22986ca6ab44db67a945e981b821, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "M\u1ED9t b\xE0n. C\xF2n c\xE1c l\u01B0\u1EE3t sau, \u0111\u1EEBng \u0111\u1EE9ng
        \u0103n m\u1EEBng."
      Poses:
      - {fileID: 21300000, guid: 2121f0269f323f64ba90cceadc94fd84, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: fb.exam.lastkick
    ReactionGroup: fb.exam.lastkick
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "C\xFA cu\u1ED1i r\u1ED3i... ch\xE2n t\u1EDB l\u1EA1i run."
      Poses:
      - {fileID: 21300000, guid: 54c331363a4367842a76a9fc67d0c5ee, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "L\u01B0\u1EE3t cu\u1ED1i. S\xFAt cho \u0111\xE0ng ho\xE0ng, t\xF4i kh\xF4ng
        cho th\xEAm l\u01B0\u1EE3t \u0111\xE2u."
      Poses:
      - {fileID: 21300000, guid: 6f387be5ded38a944bbadf12f49241d8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: fb.exam.impossible
    ReactionGroup: fb.exam.impossible
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "Em v\u1EABn ch\u01B0a \u0111\u1EE7 ba b\xE0n..."
      Poses:
      - {fileID: 21300000, guid: 0f238b424326d5f4eaceb42e22ffcc94, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Ch\u01B0a \u0111\u1EA1t. Kh\xF4ng nh\u1EADn l\u1EDDi xin th\xEAm l\u01B0\u1EE3t."
      Poses:
      - {fileID: 21300000, guid: a4cabbc0a6c81094e9ed4516f93efda8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: ch.extra.begin
    ReactionGroup: ch.extra.begin
    Priority: 0
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "B\xE0n n\xE0y ph\u1EA3i \u0111i th\u1EBF n\xE0o \u0111\xE2y..."
      Poses:
      - {fileID: 21300000, guid: eb306838f1648ff4493c1114140c26f0, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
  - Id: ch.extra.firstcorrect
    ReactionGroup: ch.extra.firstcorrect
    Priority: 0
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "\u0110\u01B0\u1EE3c n\u01B0\u1EDBc \u0111\u1EA7u r\u1ED3i... v\u1EABn
        ch\u01B0a xong."
      Poses:
      - {fileID: 21300000, guid: eb306838f1648ff4493c1114140c26f0, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "M\u1EDBi \u0111i \u0111\u01B0\u1EE3c m\u1ED9t n\u01B0\u1EDBc. \u0110\u1EEBng
        t\u01B0\u1EDFng th\u1EBF l\xE0 qua."
      Poses:
      - {fileID: 21300000, guid: f72682024a6fba6438d96db10d911d3e, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: ch.extra.lowtime
    ReactionGroup: ch.extra.lowtime
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "S\u1EAFp h\u1EBFt gi\u1EDD r\u1ED3i... t\u1EDB v\u1EABn ch\u01B0a ngh\u0129
        ra."
      Poses:
      - {fileID: 21300000, guid: 54c331363a4367842a76a9fc67d0c5ee, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "C\xF2n {secondsRemaining} gi\xE2y. C\u1EADu \u0111\u1ECBnh \u0111\u1EE3i
        t\xF4i ch\u1EC9 h\u1EBFt r\u1ED3i m\u1EDBi \u0111i \xE0?"
      Poses:
      - {fileID: 21300000, guid: dab09163e19971749928f30bad23f7b1, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: ch.extra.relief
    ReactionGroup: ch.extra.relief
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "H\u1EBFt h\u1ED3n... em qua th\u1EADt r\u1ED3i."
      Poses:
      - {fileID: 21300000, guid: 91fb22986ca6ab44db67a945e981b821, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
  - Id: frog.start.save
    ReactionGroup: frog.start.save
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "T\u1EDB t\u01B0\u1EDFng anh Tu\u1EA5n d\u1ECDa... b\u1ECB b\u1EAFt b\u1EADt
        c\xF3c th\u1EADt r\u1ED3i."
      Poses:
      - {fileID: 21300000, guid: 54c331363a4367842a76a9fc67d0c5ee, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Hai tay sau \u0111\u1EA7u, ng\u1ED3i xu\u1ED1ng. B\u1EADt h\u1EBFt {distance}
        m\xE9t trong {time} gi\xE2y, \u0111\u1EEBng \u0111\u1EE9ng nh\xECn t\xF4i."
      Poses:
      - {fileID: 21300000, guid: 69ba0aed41913c24e9d810864a109fe9, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: frog.start.charged
    ReactionGroup: frog.start.charged
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "\u0110\xE3 m\u1EA5t m\u1ED9t l\u01B0\u1EE3t r\u1ED3i... \u0111\xFAng
        l\xE0 \xE1c m\u1ED9ng."
      Poses:
      - {fileID: 21300000, guid: 0f238b424326d5f4eaceb42e22ffcc94, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "M\u1EA5t l\u01B0\u1EE3t kh\xF4ng c\xF3 ngh\u0129a l\xE0 \u0111\u01B0\u1EE3c
        b\u1ECF h\xECnh ph\u1EA1t."
      Poses:
      - {fileID: 21300000, guid: ba66c27e5cb66214282ffcc14548a836, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: frog.fall.first
    ReactionGroup: frog.fall
    Priority: 2
    CooldownSeconds: 10
    MaximumPlays: 2
    Lines:
    - Speaker: 0
      Text: Ui da!
      Poses:
      - {fileID: 21300000, guid: 6a1d60edaf60eaf478c6a59c2e02e02b, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 0.7
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "\u0110\u1EE9ng d\u1EADy v\xE0 ti\u1EBFp t\u1EE5c ngay."
      Poses:
      - {fileID: 21300000, guid: 6f387be5ded38a944bbadf12f49241d8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.8
      Icon: {fileID: 6214188408712596682, guid: 08fbbe2be910e4b08aa8a97d2fcaac5d, type: 3}
  - Id: frog.fall.repeat
    ReactionGroup: frog.fall
    Priority: 2
    CooldownSeconds: 10
    MaximumPlays: 2
    Lines:
    - Speaker: 0
      Text: "L\u1EA1i ng\xE3 n\u1EEFa r\u1ED3i..."
      Poses:
      - {fileID: 21300000, guid: 0f238b424326d5f4eaceb42e22ffcc94, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "T\xF4i b\u1EA3o b\u1EADt c\xF3c, kh\xF4ng b\u1EA3o ng\u1ED3i ngh\u1EC9."
      Poses:
      - {fileID: 21300000, guid: a107eb87b301f3d44bdbf3ece7c14b5e, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 6214188408712596682, guid: 08fbbe2be910e4b08aa8a97d2fcaac5d, type: 3}
  - Id: frog.goodjump
    ReactionGroup: frog.goodjump
    Priority: 0
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "L\u1EA7n n\xE0y xa h\u01A1n r\u1ED3i... ch\xE2n t\u1EDB m\u1ECFi qu\xE1."
      Poses:
      - {fileID: 21300000, guid: 91fb22986ca6ab44db67a945e981b821, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "T\u1EA1m \u0111\u01B0\u1EE3c. Ch\u01B0a h\u1EBFt \u0111\u01B0\u1EDDng
        th\xEC b\u1EADt ti\u1EBFp."
      Poses:
      - {fileID: 21300000, guid: f72682024a6fba6438d96db10d911d3e, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: frog.lowtime
    ReactionGroup: frog.lowtime
    Priority: 1
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "S\u1EAFp h\u1EBFt gi\u1EDD r\u1ED3i... em c\xF2n ch\u01B0a t\u1EDBi."
      Poses:
      - {fileID: 21300000, guid: 54c331363a4367842a76a9fc67d0c5ee, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Ch\u01B0a \u0111\u1EBFn v\u1EA1ch th\xEC b\u1EADt ti\u1EBFp. T\xF4i
        kh\xF4ng k\xE9o c\u1EADu v\u1EC1 \u0111\xEDch \u0111\xE2u."
      Poses:
      - {fileID: 21300000, guid: 6f387be5ded38a944bbadf12f49241d8, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 6214188408712596682, guid: 08fbbe2be910e4b08aa8a97d2fcaac5d, type: 3}
  - Id: frog.finish
    ReactionGroup: frog.finish
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "Cu\u1ED1i c\xF9ng c\u0169ng t\u1EDBi... t\u1EDB m\u1EC7t qu\xE1."
      Poses:
      - {fileID: 21300000, guid: 91fb22986ca6ab44db67a945e981b821, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Xong B\u1EADt c\xF3c. V\u1EC1 s\xE2n v\xE0 l\xE0m ti\u1EBFp ph\u1EA7n
        c\xF2n l\u1EA1i."
      Poses:
      - {fileID: 21300000, guid: 2121f0269f323f64ba90cceadc94fd84, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 2.5
      Icon: {fileID: 0}
  - Id: frog.timeout
    ReactionGroup: frog.timeout
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "Em ch\u01B0a t\u1EDBi k\u1ECBp..."
      Poses:
      - {fileID: 21300000, guid: 0f238b424326d5f4eaceb42e22ffcc94, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "H\u1EBFt gi\u1EDD. T\xF4i cho \u0111\u1EE7 th\u1EDDi gian r\u1ED3i,
        \u0111\u1EEBng xin th\xEAm."
      Poses:
