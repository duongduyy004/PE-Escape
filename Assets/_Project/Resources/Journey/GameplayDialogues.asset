  - Id: result.fail.first
    ReactionGroup: result.fail.first
    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "Tr\u01B0\u1EE3t th\u1EADt r\u1ED3i... em ph\u1EA3i b\u1EADt c\xF3c \u1EA1?"
