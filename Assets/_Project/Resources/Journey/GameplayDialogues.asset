      - {fileID: 21300000, guid: 0f238b424326d5f4eaceb42e22ffcc94, type: 3}
      PoseStepSeconds: 0.3
      DurationSeconds: 1.2
      Icon: {fileID: 0}
    - Speaker: 1
      Text: "Ch\u01B0a \u0111\u1EA1t th\xEC ra b\u1EADt c\xF3c. \u0110\u1EE9ng h\u1ECFi
        n\u1EEFa l\xE0 t\xF4i ghi t\xEAn v\xE0o s\u1ED5 \u0111\u1EA5y."
