    Priority: 3
    CooldownSeconds: 0
    MaximumPlays: 1
    Lines:
    - Speaker: 0
      Text: "L\u1EA1i tr\u01B0\u1EE3t \u0111\xFAng ch\u1ED7 \u0111\xF3 r\u1ED3i..."
